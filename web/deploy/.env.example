# Copy to web/deploy/.env (gitignored) and fill in. `docker compose` reads this
# file both for ${...} substitution in docker-compose.yml and as the
# environment of the app containers. Never commit the real one.
#
# Generate random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-50-random-characters
DJANGO_ALLOWED_HOSTS=cellcounts.matthewbolding.com
CELLCOUNTS_SITE_URL=https://cellcounts.matthewbolding.com
TZ=America/Chicago

# --- Database (container `db`; host and port are set in docker-compose.yml) ----
POSTGRES_DB=cellcounts
POSTGRES_USER=cellcounts
POSTGRES_PASSWORD=change-me-random

# --- Email (Resend, sending from the verified matthewbolding.com domain) -------
RESEND_API_KEY=re_change_me
CELLCOUNTS_FROM_EMAIL=Cell Counts <cellcounts@matthewbolding.com>

# --- Cloudflare ---------------------------------------------------------------
# Turnstile widget for cellcounts.matthewbolding.com (Cloudflare dashboard > Turnstile).
TURNSTILE_SITE_KEY=0x_change_me
TURNSTILE_SECRET_KEY=0x_change_me
# The tunnel token goes in tunnel.env (see tunnel.env.example), not here: every
# app container loads this file, and none of them needs the token.

# --- Storage ------------------------------------------------------------------
# Where the NAS share is mounted on the host. It's bind-mounted at /data in the
# containers (CELLCOUNTS_DATA_ROOT=/data is set in docker-compose.yml).
NAS_MOUNT=/mnt/cellcounts
# Default per-user quota for new accounts (admins can change it per user).
CELLCOUNTS_DEFAULT_QUOTA_GB=150

# UID/GID the app runs as, and so the owner of files it writes to the NAS.
# For an Unraid share that squashes everything to nobody:users, use 99/100 so
# ownership matches whether or not squashing applies. Changing these needs a
# rebuild (`docker compose build`).
APP_UID=99
APP_GID=100

# --- Optional -----------------------------------------------------------------
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=8
# BACKUP_HOUR=3        # local time (TZ) of the nightly database dump
# BACKUP_KEEP=14       # number of nightly dumps kept on the NAS
# IMAGE_TAG=current    # tag for the locally built images
